FROM rockylinux/rockylinux:9.6-ubi

RUN dnf install -y --setopt=install_weak_deps=False \
    ca-certificates \
    cmake \
    gcc-c++ \
    make \
    git \
    python3 \
    python3-pip \
    && dnf clean all

# RHEL 9 marks the system Python as externally managed (PEP 668). Use a venv
# that inherits system pip (--system-site-packages) to sidestep both
# --break-system-packages and ensurepip quirks. hatchling is installed here so
# `python -m build --no-isolation` works without network.
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:${PATH}
RUN pip install --upgrade pip build hatchling

WORKDIR /work